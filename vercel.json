{
  "rewrites": [
    {
      "source": "/portfolio.pdf",
      "destination": "/api/proxy?path=/Sahar-Khayyati-Portfolio.pdf"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
